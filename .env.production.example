# Copy to .env.production and replace every placeholder before starting PM2.
ENVIRONMENT=production
PROJECT_NAME=Full Stack FastAPI Template
FRONTEND_HOST=https://app.example.com
BACKEND_CORS_ORIGINS=https://app.example.com
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=changethis

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=changethis
CELERY_VISIBILITY_TIMEOUT_SECONDS=3600
CELERY_RESULT_EXPIRES_SECONDS=900

SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
SMTP_TLS=true
SMTP_SSL=false
SMTP_PORT=587
EMAIL_TEST_USER=replace-with-ops@example.com

INVENTORY_DAILY_REPORT_RECIPIENTS={}
# Comma-separated operations recipients for scheduler failure and overlap alerts.
SCHEDULED_TASK_ALERT_RECIPIENTS=
SENTRY_DSN=
